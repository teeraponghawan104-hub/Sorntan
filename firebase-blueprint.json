{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher or student teacher record with master timetable schedule for Worakhun Uppatham School (shared across all school devices)",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Teacher numeric code (e.g., 102, 205, 307)"
        },
        "n": {
          "type": "string",
          "description": "Full name in Thai",
          "minLength": 1,
          "maxLength": 120
        },
        "g": {
          "type": "string",
          "description": "Primary department group used for substitute matching",
          "minLength": 1,
          "maxLength": 60
        },
        "pdfGroup": {
          "type": "string",
          "description": "Department or unit displayed on the official PDF header",
          "minLength": 1,
          "maxLength": 60
        },
        "r": {
          "type": "string",
          "description": "Default classroom number or name",
          "minLength": 1,
          "maxLength": 60
        },
        "totalHours": {
          "type": "number",
          "description": "Total weekly hours"
        },
        "coursesSummary": {
          "type": "array",
          "description": "List of courses taught summary lines",
          "maxLength": 15
        },
        "otherSummary": {
          "type": "string",
          "description": "Summary of PLC and other school activities",
          "maxLength": 300
        },
        "s": {
          "type": "string",
          "description": "Encoded 5-day x 7-period schedule separated by | and ,",
          "maxLength": 1200
        },
        "isStudentTeacher": {
          "type": "boolean",
          "description": "Whether the person is a student teacher"
        },
        "ownerId": {
          "type": "string",
          "description": "Shared school scope identifier ('worakhun_shared')",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "n",
        "g",
        "pdfGroup",
        "r",
        "totalHours",
        "coursesSummary",
        "otherSummary",
        "s",
        "isStudentTeacher",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubstituteRecord": {
      "title": "SubstituteRecord",
      "description": "Saved substitute teaching assignment sheet or live shared planner workspace for Worakhun Uppatham School",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "description": "Unique document ID (e.g., live_workspace or rec_102_20261102)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "absentTeacherId": {
          "type": "number",
          "description": "Numeric ID of the primary absent teacher"
        },
        "absentTeacherName": {
          "type": "string",
          "description": "Name(s) of the absent teacher(s) in the single table",
          "minLength": 1,
          "maxLength": 300
        },
        "absentTeacherGroup": {
          "type": "string",
          "description": "Department group(s) of the absent teacher(s)",
          "minLength": 1,
          "maxLength": 150
        },
        "selectedDate": {
          "type": "string",
          "description": "ISO date string YYYY-MM-DD",
          "minLength": 8,
          "maxLength": 20
        },
        "reason": {
          "type": "string",
          "description": "Leave or official duty reason",
          "minLength": 1,
          "maxLength": 200
        },
        "studentTeacherName": {
          "type": "string",
          "description": "Optional custom student teacher name",
          "maxLength": 120
        },
        "includeSupervision": {
          "type": "boolean",
          "description": "Whether supervision periods are included"
        },
        "assignmentsJson": {
          "type": "string",
          "description": "Compact period-to-substitute assignment mapping string including multi-teacher list",
          "maxLength": 2000
        },
        "ownerId": {
          "type": "string",
          "description": "Shared school scope identifier ('worakhun_shared')",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "recordId",
        "absentTeacherId",
        "absentTeacherName",
        "absentTeacherGroup",
        "selectedDate",
        "reason",
        "studentTeacherName",
        "includeSupervision",
        "assignmentsJson",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubjectMapping": {
      "title": "SubjectMapping",
      "description": "Custom mapping from subject code to display subject name (shared school scope)",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "description": "Document ID ('custom')",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mappingsJson": {
          "type": "string",
          "description": "JSON serialized object mapping subject code to custom subject name",
          "maxLength": 5000
        },
        "ownerId": {
          "type": "string",
          "description": "Shared school scope identifier ('worakhun_shared')",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "recordId",
        "mappingsJson",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Stores shared teacher and student teacher profiles and 5x7 timetables for all users"
    },
    "/substitute_records/{recordId}": {
      "schema": { "$ref": "#/entities/SubstituteRecord" },
      "description": "Stores shared saved substitute teaching assignment forms and live auto-saved planner state"
    },
    "/subject_mappings/{mappingId}": {
      "schema": { "$ref": "#/entities/SubjectMapping" },
      "description": "Stores custom subject code to subject name mapping overrides"
    }
  }
}
