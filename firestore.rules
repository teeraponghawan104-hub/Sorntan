rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test endpoint
    match /test/connection {
      allow get: if true;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSharedScope(ownerId) {
      return ownerId is string &&
        ownerId.size() >= 1 &&
        ownerId.size() <= 128 &&
        ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        ownerId == 'worakhun_shared';
    }

    // Validation Blueprint: Teacher
    function isValidTeacher(data) {
      return data.keys().hasAll([
        'id',
        'n',
        'g',
        'pdfGroup',
        'r',
        'totalHours',
        'coursesSummary',
        'otherSummary',
        's',
        'isStudentTeacher',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'n',
        'g',
        'pdfGroup',
        'r',
        'totalHours',
        'coursesSummary',
        'otherSummary',
        's',
        'isStudentTeacher',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is number && data.id >= 1 && data.id <= 99999 &&
      data.n is string && data.n.size() >= 1 && data.n.size() <= 120 &&
      data.g is string && data.g.size() >= 1 && data.g.size() <= 60 &&
      data.pdfGroup is string && data.pdfGroup.size() >= 1 && data.pdfGroup.size() <= 60 &&
      data.r is string && data.r.size() >= 1 && data.r.size() <= 60 &&
      data.totalHours is number && data.totalHours >= 0 && data.totalHours <= 60 &&
      data.coursesSummary is list && data.coursesSummary.size() <= 15 &&
      (data.coursesSummary.size() == 0 || (data.coursesSummary[0] is string && data.coursesSummary[0].size() <= 200)) &&
      data.otherSummary is string && data.otherSummary.size() <= 300 &&
      data.s is string && data.s.size() <= 1200 &&
      data.isStudentTeacher is bool &&
      isSharedScope(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: SubstituteRecord
    function isValidSubstituteRecord(data) {
      return data.keys().hasAll([
        'recordId',
        'absentTeacherId',
        'absentTeacherName',
        'absentTeacherGroup',
        'selectedDate',
        'reason',
        'studentTeacherName',
        'includeSupervision',
        'assignmentsJson',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'recordId',
        'absentTeacherId',
        'absentTeacherName',
        'absentTeacherGroup',
        'selectedDate',
        'reason',
        'studentTeacherName',
        'includeSupervision',
        'assignmentsJson',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 128 && data.recordId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.absentTeacherId is number && data.absentTeacherId >= 1 && data.absentTeacherId <= 99999 &&
      data.absentTeacherName is string && data.absentTeacherName.size() >= 1 && data.absentTeacherName.size() <= 300 &&
      data.absentTeacherGroup is string && data.absentTeacherGroup.size() >= 1 && data.absentTeacherGroup.size() <= 150 &&
      data.selectedDate is string && data.selectedDate.size() >= 8 && data.selectedDate.size() <= 20 &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 200 &&
      data.studentTeacherName is string && data.studentTeacherName.size() <= 120 &&
      data.includeSupervision is bool &&
      data.assignmentsJson is string && data.assignmentsJson.size() <= 2000 &&
      isSharedScope(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /teachers/{teacherId}
    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && (resource == null || existing().ownerId == 'worakhun_shared');
      allow list: if resource.data.ownerId == 'worakhun_shared';
      allow create: if isValidId(teacherId) && isValidTeacher(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(teacherId) && isValidTeacher(incoming()) &&
        existing().ownerId == 'worakhun_shared' &&
        incoming().ownerId == existing().ownerId &&
        ('createdAt' in existing() ? incoming().createdAt == existing().createdAt : incoming().createdAt == request.time) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id',
          'n',
          'g',
          'pdfGroup',
          'r',
          'totalHours',
          'coursesSummary',
          'otherSummary',
          's',
          'isStudentTeacher',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(teacherId) && existing().ownerId == 'worakhun_shared';
    }

    // Collection: /substitute_records/{recordId}
    match /substitute_records/{recordId} {
      allow get: if isValidId(recordId) && (resource == null || existing().ownerId == 'worakhun_shared');
      allow list: if resource.data.ownerId == 'worakhun_shared';
      allow create: if isValidId(recordId) && isValidSubstituteRecord(incoming()) &&
        incoming().recordId == recordId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) && isValidSubstituteRecord(incoming()) &&
        existing().ownerId == 'worakhun_shared' &&
        incoming().recordId == existing().recordId &&
        incoming().ownerId == existing().ownerId &&
        ('createdAt' in existing() ? incoming().createdAt == existing().createdAt : incoming().createdAt == request.time) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'recordId',
          'absentTeacherId',
          'absentTeacherName',
          'absentTeacherGroup',
          'selectedDate',
          'reason',
          'studentTeacherName',
          'includeSupervision',
          'assignmentsJson',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(recordId) && existing().ownerId == 'worakhun_shared';
    }
  }
}
